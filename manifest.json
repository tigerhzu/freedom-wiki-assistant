{
  "manifest_version": 3,
  "name": "Freedom Wiki Assistant",
  "version": "0.1.4",
  "description": "Markdown Wiki 編輯輔助：文字格式化、圖片上傳、範本與版面整理。",
  "icons": {
    "16": "icons/wiki_logo.png",
    "32": "icons/wiki_logo.png",
    "48": "icons/wiki_logo.png",
    "128": "icons/wiki_logo.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://wiki.example.invalid/*"],
  "content_scripts": [
    {
      "matches": ["https://wiki.example.invalid/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://wiki.example.invalid/*"]
    },
    {
      "resources": ["pet/*"],
      "matches": ["https://wiki.example.invalid/*"]
    }
  ]
}
