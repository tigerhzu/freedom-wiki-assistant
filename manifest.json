{
  "manifest_version": 3,
  "name": "Wiki Studio · Freedom Wiki Assistant",
  "version": "0.3.4",
  "description": "Wiki Studio：Wiki.js 視覺編輯、圖片管理、模板與 AI 排版工作台。",
  "icons": {
    "16": "icons/wiki_logo_16.png",
    "32": "icons/wiki_logo_32.png",
    "48": "icons/wiki_logo_48.png",
    "128": "icons/wiki_logo_128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://wiki.example.invalid/*",
    "https://ornith.example.invalid/*",
    "https://*.openai.azure.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://wiki.example.invalid/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "src/settings/settings.html",
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://wiki.example.invalid/*"]
    },
    {
      "resources": ["pet/*"],
      "matches": ["https://wiki.example.invalid/*"]
    }
  ]
}
