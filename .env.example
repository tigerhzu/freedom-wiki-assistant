# Target Wiki origin. Use an HTTPS origin only; do not include a trailing slash or path.
VITE_WIKI_ORIGIN=https://wiki.example.invalid
# Optional: default path used when creating a customer shortcut.
VITE_CUSTOMER_BASE_PATH=/docs/clients
# AI API Keys are entered in the extension settings page and stored in chrome.storage.local.
# Never place Ornith or Azure API Keys in this file.
